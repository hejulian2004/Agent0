# ==============================================================================
# Agent0-VL & HJL Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file or credentials to git!
# ==============================================================================

# Responses API Endpoint & Credentials
# e.g., https://api.openai.com/v1 or http://127.0.0.1:8000/v1
AGENT0_RESPONSES_BASE_URL=http://127.0.0.1:8000/v1
AGENT0_RESPONSES_API_KEY=your-api-key-here
AGENT0_RESPONSES_MODEL=qwen2.5-vl-7b-instruct

# Call Parameters & Limits (optional overrides)
AGENT0_RESPONSES_TIMEOUT_SECONDS=180
AGENT0_RESPONSES_MAX_RETRIES=3
AGENT0_RESPONSES_MAX_TOOL_ROUNDS=8
AGENT0_RESPONSES_MAX_OUTPUT_TOKENS=2048

# Sandbox Service (required only when sandbox.backend is 'remote')
# AGENT0_SANDBOX_ENDPOINT=http://127.0.0.1:8080
